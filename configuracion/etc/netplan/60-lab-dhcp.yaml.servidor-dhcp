# AVISO: IPs de ejemplo (192.168.1.50 y red DHCP 192.168.50.0/24); usa tu último octeto.
network:
  version: 2
  ethernets:
    enp0s3:              # Adaptador 1 - NAT: internet, DNS y ruta por defecto
      dhcp4: true
    enp0s8:              # Adaptador 2 - Puente: red de prácticas 192.168.1.0/24
      dhcp4: false
      addresses:
        - 192.168.1.50/24
    enp0s9:              # Adaptador 3 - Puente: red DHCP de Kea (192.168.<octeto>.0/24)
      dhcp4: false
      addresses:
        - 192.168.50.1/24
